rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'icre8te2026@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- CATEGORIES ---
    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'order', 'slug']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.order is number &&
             data.slug is string && data.slug.matches('^[a-z0-9-]+$') &&
             (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 1000)) &&
             data.keys().size() >= 3 && data.keys().size() <= 5;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if (isAdmin() || !isSignedIn()) && isValidId(categoryId); 
      allow update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // --- MENU ITEMS ---
    function isValidMenuItem(data) {
      let core = data.keys().hasAll(['categoryId', 'name', 'price']) &&
                 data.categoryId is string &&
                 data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
                 data.price is number && data.price >= 0;
      
      let optional = (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 2000)) &&
                     (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
                     (!data.keys().hasAny(['isVegetarian']) || data.isVegetarian is bool) &&
                     (!data.keys().hasAny(['isVegan']) || data.isVegan is bool) &&
                     (!data.keys().hasAny(['isSpicy']) || data.isSpicy is bool) &&
                     (!data.keys().hasAny(['isGlutenFree']) || data.isGlutenFree is bool) &&
                     (!data.keys().hasAny(['isAvailable']) || data.isAvailable is bool) &&
                     (!data.keys().hasAny(['popular']) || data.popular is bool);
      
      return core && optional;
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if (isAdmin() || !isSignedIn()) && isValidMenuItem(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- RESERVATIONS ---
    function isValidReservation(data) {
      return data.keys().hasAll(['customerName', 'email', 'date', 'time', 'guests', 'status']) &&
             data.customerName is string && data.customerName.size() <= 150 &&
             data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.date is string &&
             data.time is string &&
             data.guests is number && data.guests > 0 && data.guests <= 50 &&
             data.status in ['pending', 'confirmed', 'cancelled'];
    }

    match /reservations/{reservationId} {
      allow create: if isValidReservation(incoming());
      allow read: if isAdmin() || (isSignedIn() && (resource == null || existing().email == request.auth.token.email));
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- ORDERS ---
    function isValidOrder(data) {
      return data.keys().hasAll(['items', 'total', 'customerName', 'status', 'createdAt']) &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.customerName is string &&
             data.status in ['pending', 'preparing', 'delivering', 'delivered', 'cancelled'] &&
             (!data.keys().hasAny(['userId']) || data.userId is string);
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(incoming());
      allow read: if isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid || existing().email == request.auth.token.email));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- USERS (Profiles) ---
    function isValidUser(data) {
      return (!data.keys().hasAny(['address']) || (data.address is string && data.address.size() <= 500)) &&
             (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 50)) &&
             (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 200));
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }

    // --- SETTINGS ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
